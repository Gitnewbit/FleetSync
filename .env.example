# FleetSync Pro — Environment Variables
# Copy to .env — never commit .env to git

PORT=5000

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# IT Manager credentials (auto-created on first start)
ADMIN_EMAIL=admin@fleetsync.pro
ADMIN_PASSWORD=FleetSync2024!

# SQLite path — leave blank for local ./fleetsync.db
# Render.com: set to /var/data/fleetsync.db
DATABASE_PATH=

# CORS — leave blank to allow all origins (fine for private tools)
CORS_ORIGIN=

# Set to "production" when serving React build through Express
NODE_ENV=development
